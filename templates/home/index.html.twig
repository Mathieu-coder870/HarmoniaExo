{% extends 'base.html.twig' %}

{% block title %}Hello HomeController!
{% endblock %}

{% block body %}
	<style>
		.example-wrapper {
			margin: 1em auto;
			max-width: 800px;
			width: 95%;
			font: 18px / 1.5 sans-serif;
		}
		.example-wrapper code {
			background: #F5F5F5;
			padding: 2px 6px;
		}
	</style>
	<div>
		<h3>Les EPs</h3>
		{% for album in epType %}
			{% include 'components/album-card.html.twig' with {album:album} %}
			{% endfor%}
		</div>

		<div>
			<h3>Les Albums</h3>
			{% for album in albumType %}
				{% include 'components/album-card.html.twig' with {album:album} %}
				{% endfor%}
			</div>

			<div>
				<h3>Les singles
				</h3>
				{% for album in singleType %}
					{% include 'components/album-card.html.twig' with {album:album} %}
					{% endfor%}
				</div>

			{% endblock %}
