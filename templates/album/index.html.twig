{% extends 'base.html.twig' %}

{% block title %}Hello AlbumController!
{% endblock %}

{% block body %}
	<style>
		.example-wrapper {
			margin: 1em auto;
			max-width: 800px;
			width: 95%;
			font: 18px / 1.5 sans-serif;
		}
		.example-wrapper code {
			background: #F5F5F5;
			padding: 2px 6px;
		}
	</style>

	<div class="example-wrapper">
		<h1></h1>
		<div class="card" style="width: 18rem;">
			<img src="{{asset(album.pouch)}}" class="card-img-top" alt="...">
			<div class="card-body">
				<h5 class="card-title">{{ album.title }}</h5>
				<p class="card-text">nombre de morceaux :
					{{album.tracks|length}}
				</p>

				<a href={{path("app_track_create", {'id':album.id} )}} " class=" btn btn-primary">Ajouter un morceau</a>
			</div>
		</div>

	</div>

	<div class="card">
		<div class="card-body">
			<h5 class="card-title">Les morceaux:
			</h5>
			{%for track in album.tracks%}
				<p class="card-text">{{track.title}}</p>
				<a href="{{path("app_favorite_create", {'track_id': track.id})}}" class=" btn btn-primary">Mettre en favori</a>

			{% endfor %}
		</div>
	</div>

{% endblock %}
